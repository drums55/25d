## Allies the rider has (flags in ALLIES that are set).
static func allies(flags: Dictionary) -> Array:
	var out: Array = []
	for f in ALLIES:
		if flags.get(f, false):
			out.append(f)
	return out


## Ending id for opening the valve with `count` allies.
static func for_valve(count: int) -> String:
	if count >= BEST:
		return "five_stars"
	if count >= OKAY:
		return "wet"
	return "sunk"
